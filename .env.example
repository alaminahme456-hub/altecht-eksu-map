# Supabase PostgreSQL connection strings.
# Replace [YOUR-PASSWORD] with the database password from Supabase > Project Settings > Database.
# Use the direct connection for DIRECT_URL; if your hosting platform requires IPv4,
# use the Supabase Session Pooler connection string for DATABASE_URL.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.gsvnefxrxexdyptknsjh:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.gsvnefxrxexdyptknsjh:5432/postgres?sslmode=require"

# Administrator password for the data-collection dashboard (#/admin).
# Set a strong value in production — never use the demo default.
ADMIN_PASSWORD=change-me

# Secret used to sign admin session cookies. Set a long random value in production.
SESSION_SECRET=change-me-too

# Supabase Storage bucket for campus photos (configured in the Supabase project).
SUPABASE_URL="https://gsvnefxrxexdyptknsjh.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_REPLACE_WITH_PROJECT_PUBLISHABLE_KEY"
# Keep any Supabase secret/service-role key server-only. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
