# Supabase PostgreSQL connection strings.
# Copy these from Supabase Dashboard > Connect.
# DATABASE_URL: Transaction Pooler connection string (recommended for serverless hosting).
# DIRECT_URL: Direct connection string (used by Prisma schema operations).
DATABASE_URL="PASTE_SUPABASE_TRANSACTION_POOLER_CONNECTION_STRING"
DIRECT_URL="PASTE_SUPABASE_DIRECT_CONNECTION_STRING"

# Administrator password for the data-collection dashboard (#/admin).
# Set a strong value in production — never use the demo default.
ADMIN_PASSWORD=change-me

# Secret used to sign admin session cookies. Set a long random value in production.
SESSION_SECRET=change-me-too

# Supabase Storage configuration. Keep secret keys server-only.
SUPABASE_URL="https://gsvnefxrxexdyptknsjh.supabase.co"
SUPABASE_PUBLISHABLE_KEY="PASTE_SUPABASE_PUBLISHABLE_KEY"
SUPABASE_SECRET_KEY=
