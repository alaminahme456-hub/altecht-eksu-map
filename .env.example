# SQLite database file (created by `bun run db:push`)
DATABASE_URL=file:./db/custom.db

# Administrator password for the data-collection dashboard (#/admin).
# Set a strong value in production — the demo default lives in src/lib/auth.ts.
ADMIN_PASSWORD=change-me

# Secret used to sign admin session cookies. Defaults to a value derived from
# ADMIN_PASSWORD when unset; set an explicit random string in production.
SESSION_SECRET=change-me-too
