generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// A campus feature: building, faculty, gate, road/pathway, etc.
// GPS values remain the original WGS84 coordinates collected in the field.
// GeoJSON vertices are stored in their original [longitude, latitude] order.
model Location {
  id           String   @id @default(cuid())
  name         String
  category     String
  description  String?
  lat          Float
  lng          Float
  geometryType String   @default("point")
  coordinates  String?
  status       String   @default("draft")
  source       String   @default("admin")
  externalId   String?
  // PostGIS spatial index column is maintained separately in SQL.
  spatial      Unsupported("geometry(Geometry, 4326)")?
  photos       Photo[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
  @@index([status])
  @@index([name])
  @@map("Location")
}

model Photo {
  id         String   @id @default(cuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  filename   String
  caption    String?
  createdAt  DateTime @default(now())

  @@index([locationId])
  @@map("Photo")
}
