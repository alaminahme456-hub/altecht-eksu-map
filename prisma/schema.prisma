generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A campus feature: building, faculty, gate, road/pathway, etc.
// Geometry rules (data accuracy policy):
//  - lat/lng ALWAYS store the original collected GPS point (or polygon centroid for reference only).
//  - `coordinates` stores the ORIGINAL captured vertex list as JSON [[lng,lat], ...]
//    for polygon (outline) or polyline (road/pathway) features. Coordinates are
//    never rounded, re-projected or reordered on import/export.
model Location {
  id           String   @id @default(cuid())
  name         String
  category     String // one of CATEGORIES (see src/lib/categories.ts)
  description  String?
  lat          Float // original GPS latitude (WGS84)
  lng          Float // original GPS longitude (WGS84)
  geometryType String   @default("point") // point | polygon | polyline
  coordinates  String? // JSON [[lng,lat],...] original vertices for polygon/polyline
  status       String   @default("draft") // draft (unverified) | verified
  source       String   @default("admin") // admin | sample | import
  externalId   String? // e.g. OSM way/relation id or imported feature id
  photos       Photo[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Photographs uploaded through the admin dashboard, stored under /public/uploads.
model Photo {
  id         String   @id @default(cuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  filename   String // public URL path e.g. /uploads/xxx.jpg
  caption    String?
  createdAt  DateTime @default(now())
}
